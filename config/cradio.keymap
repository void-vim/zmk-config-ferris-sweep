// Mouse move speed 2500, scroll step 20 (Zephyr HID report units)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        // tap = letter, hold = modifier
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <(-1)>;
            bindings = <&kp>, <&kp>;
        };
        // mouse cursor acceleration
        mmv {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <300>;
            delay-ms = <0>;
        };
        // mouse scroll acceleration
        msc {
            acceleration-exponent = <0>;
            time-to-max-speed-ms = <40>;
            delay-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // hold left fn (numbers layer, pos 30) + tap T (pos 4) -> toggle mouse layer
        combo_mouse {
            key-positions = <30 4>;
            layers = <1>;
            timeout-ms = <50>;
            bindings = <&tog 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
/* row1 */ &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P
/* row2 */ &ht LSHIFT A &ht LALT S &ht LCTRL D &ht LGUI F &kp G    &kp H        &ht LGUI J   &ht LCTRL K   &ht LALT L    &ht RSHIFT APOSTROPHE
/* row3 */ &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N        &kp M        &kp COMMA    &kp DOT      &kp SLASH
/* thmb */ &mo 1     &kp SPACE                      &kp ENTER   &mo 2
            >;
        };

        number_layer {
            bindings = <
/* row1 */ &mo 1  &kp N1  &kp N2  &kp N3  &kp TAB    &kp HOME   &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &kp TILDE
/* row2 */ &mo 1  &kp N4  &kp N5  &kp N6  &kp BSPC   &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT &kp SEMICOLON
/* row3 */ &mo 1  &kp N7  &kp N8  &kp N9  &kp N0     &none     &none         &none        &none  &none
/* thmb */ &mo 1  &kp ESC                          &none     &mo 1
            >;
        };

        symbol_layer {
            bindings = <
/* row1 */ &mo 1  &kp LBKT &kp LBRC  &kp RBRC  &none    &kp CARET  &kp LPAR  &kp RPAR  &kp RBKT &kp TILDE
/* row2 */ &kp EXCLAMATION &kp AT &kp HASH &kp DOLLAR &kp PERCENT  &kp ASTERISK &kp MINUS &kp EQUAL &kp BACKSLASH &kp GRAVE
/* row3 */ &none  &studio_unlock &none  &none  &none     &kp AMPERSAND &kp UNDERSCORE &kp PLUS  &kp PIPE  &none
/* thmb */ &mo 1  &none                          &none     &mo 2
            >;
        };

        mouse_layer {
            bindings = <
/* row1 */ &trans  &trans  &trans  &trans  &mkp LCLK   &msc SCRL_UP  &msc SCRL_DOWN  &mkp MCLK  &mkp MB4  &mkp MB5
/* row2 */ &trans  &trans  &trans  &trans  &trans      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
/* row3 */ &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
/* thmb */ &trans  &trans                          &trans  &tog 3
            >;
        };
    };
};
